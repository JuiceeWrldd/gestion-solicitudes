{
  "name": "gestion-solicitudes",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "homepage": "https://juiceewrldd.github.io/gestion-solicitudes/",
  "scripts": {
    "dev": "vite",
    "demo": "firebase emulators:exec --only auth,firestore --project demo-gestion-solicitudes \"node scripts/datos-demo.mjs && vite --mode emulador\"",
    "build": "tsc && vite build",
    "test": "vitest",
    "test:reglas": "firebase emulators:exec --only firestore --project demo-gestion-solicitudes \"vitest run --config vitest.reglas.config.ts\"",
    "preview": "vite preview",
    "typecheck": "tsc",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "build:firebase": "tsc && vite build --mode firebase",
    "predeploy": "npm run build",
    "deploy": "gh-pages -d dist",
    "deploy:firebase": "npm run build:firebase && npx firebase deploy --only hosting"
  },
  "dependencies": {
    "firebase": "^12.13.0",
    "lucide-react": "^0.487.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@firebase/rules-unit-testing": "^5.0.2",
    "@tailwindcss/vite": "^4.1.12",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "firebase-tools": "^15.37.0",
    "gh-pages": "^6.3.0",
    "globals": "^17.14.0",
    "jsdom": "^30.0.1",
    "prettier": "^3.10.1",
    "tailwindcss": "^4.1.12",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.74.0",
    "vite": "^6.4.2",
    "vitest": "^4.1.11"
  }
}
