# Modo demo (npm run demo): la app se conecta a los emuladores de Firebase en tu equipo.
# Estos valores no son secretos ni de un proyecto real; el id "demo-..." hace que Firebase no salga a internet.
VITE_EMULADOR=true
VITE_FIREBASE_API_KEY=demo
VITE_FIREBASE_AUTH_DOMAIN=demo-gestion-solicitudes.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=demo-gestion-solicitudes
VITE_FIREBASE_STORAGE_BUCKET=demo-gestion-solicitudes.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=0
VITE_FIREBASE_APP_ID=demo
