rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function estaAutenticado() {
      return request.auth != null;
    }

    // tiene perfil y no está desactivado
    function tienePerfil() {
      return estaAutenticado()
        && exists(/databases/$(database)/documents/usuarios/$(request.auth.uid))
        && get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.get('activo', true) == true;
    }

    // empresa del usuario que hace la petición (null si no tiene)
    function miOrg() {
      return tienePerfil()
        ? get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.get('orgId', null)
        : null;
    }

    // el rol y la empresa se leen de la base de datos, no de lo que mande el navegador
    function esAdmin() {
      return tienePerfil()
        && miOrg() != null
        && get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.rol == 'admin';
    }

    // cada uno lee solo su empresa; las empresas se crean a mano desde la consola
    match /organizaciones/{orgId} {
      allow read: if estaAutenticado() && miOrg() == orgId;
      allow write: if false;
    }

    match /usuarios/{uid} {
      // cada uno ve su perfil; el admin ve los de su empresa
      allow read: if estaAutenticado()
        && (request.auth.uid == uid
            || (esAdmin() && resource.data.get('orgId', null) == miOrg()));

      // solo el admin crea perfiles, y siempre como "usuario" de su propia empresa
      allow create: if esAdmin()
        && request.resource.data.rol == 'usuario'
        && request.resource.data.orgId == miOrg();

      allow update:
        // el admin cambia la oficina y activa o desactiva a los de su empresa (a sí mismo no se desactiva)
        if (esAdmin()
            && resource.data.get('orgId', null) == miOrg()
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['departamento', 'activo'])
            && !(uid == request.auth.uid && request.resource.data.get('activo', true) == false))
        // cada uno puede quitar su propia marca de "cambiar clave", pero no tocar su rol, oficina ni empresa
        || (estaAutenticado()
            && request.auth.uid == uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['debeCambiarClave'])
            && request.resource.data.debeCambiarClave == false);

      allow delete: if false;
    }

    match /solicitudes/{id} {
      // cada uno ve las suyas; el admin ve las de su empresa
      allow read: if estaAutenticado()
        && (resource.data.usuarioId == request.auth.uid
            || (esAdmin() && resource.data.get('orgId', null) == miOrg()));

      // al crear, tiene que ser suya, de su empresa y empezar "En revisión"
      allow create: if estaAutenticado()
        && miOrg() != null
        && request.resource.data.usuarioId == request.auth.uid
        && request.resource.data.orgId == miOrg()
        && request.resource.data.estado == 'En revisión'
        && !('respuestaAdmin' in request.resource.data);

      allow update: if
        // el admin solo cambia el estado y la respuesta, y solo en su empresa
        (esAdmin()
          && resource.data.get('orgId', null) == miOrg()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['estado', 'respuestaAdmin']))
        // el dueño solo edita mientras siga en revisión
        || (estaAutenticado()
          && resource.data.usuarioId == request.auth.uid
          && resource.data.estado == 'En revisión'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['titulo', 'tipo', 'descripcion', 'prioridad']));

      // solo el dueño borra, y solo si sigue en revisión
      allow delete: if estaAutenticado()
        && resource.data.usuarioId == request.auth.uid
        && resource.data.estado == 'En revisión';
    }
  }
}
